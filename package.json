{
  "name": "sistema-eventos-aforo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun --cwd apps/backend dev",
    "dev:frontend": "bun --cwd apps/frontend dev",
    "test:backend": "bun --cwd apps/backend test",
    "build": "bun --cwd apps/backend build && bun --cwd apps/frontend build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
